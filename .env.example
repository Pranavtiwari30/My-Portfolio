# ── AI features ───────────────────────────────────────────────────────────────
# The "AI deep dive" and "contact assistant" call an OpenAI-compatible
# chat-completions endpoint. Set these in Vercel (Project → Settings → Environment
# Variables) for production, or copy this file to `.env.local` for `npm run dev`.
#
# Without AI_API_KEY the site still works — the AI panels show a friendly
# "not configured yet" message instead of failing.

# ── Free options (no credit card, no billing) ────────────────────────────────
# Groq      → console.groq.com/keys
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#
# Google Gemini → aistudio.google.com/apikey
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.0-flash
#
# Cerebras  → cloud.cerebras.ai
#   AI_BASE_URL=https://api.cerebras.ai/v1
#   AI_MODEL=llama-3.3-70b
#
# OpenRouter (free models) → openrouter.ai/keys
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Required: your provider API key
AI_API_KEY=

# Optional: OpenAI-compatible base URL (default: https://api.openai.com/v1)
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional: model id for the chosen provider (default: gpt-4o-mini)
AI_MODEL=llama-3.3-70b-versatile
