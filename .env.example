# ── AI features ───────────────────────────────────────────────────────────────
# The "AI deep dive" and "contact assistant" call an OpenAI-compatible
# chat-completions endpoint. Set these in Vercel (Project → Settings → Environment
# Variables) for production, or copy this file to `.env.local` for `npm run dev`.
#
# Without AI_API_KEY the site still works — the AI panels show a friendly
# "not configured yet" message instead of failing.

# ── Free options (no credit card, no billing) ────────────────────────────────
# Groq      → console.groq.com/keys  (check console.groq.com/docs/models for the
#             current model list — Groq retires models regularly)
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
#
# Google Gemini → aistudio.google.com/apikey
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.0-flash
#
# Cerebras  → cloud.cerebras.ai
#   AI_BASE_URL=https://api.cerebras.ai/v1
#   AI_MODEL=llama-3.3-70b
#
# OpenRouter (free models) → openrouter.ai/keys
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Required: your provider API key
AI_API_KEY=

# Optional: OpenAI-compatible base URL (default: https://api.openai.com/v1)
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional: model id for the chosen provider (default: gpt-4o-mini)
AI_MODEL=openai/gpt-oss-120b

# ── Contact assistant email delivery (Resend) ────────────────────────────────
# The "Send to Pranav" button in the contact assistant POSTs to /api/contact,
# which emails the site owner via Resend (resend.com — free tier, no credit card).
# Without RESEND_API_KEY the button still shows but returns a "not configured"
# notice, and visitors fall back to the copy / open-in-email actions.
#
#   1. Create the Resend account with the OWNER address (the same address in
#      profile.email / CONTACT_TO_EMAIL). The shared onboarding@resend.dev sender
#      can ONLY deliver to that address until you verify a domain in Resend.
#   2. Create an API key at resend.com/api-keys.

RESEND_API_KEY=

# Optional: recipient override (default: profile.email from src/lib/portfolio-data.ts)
# CONTACT_TO_EMAIL=

# Optional: sender override (default: "Portfolio contact <onboarding@resend.dev>").
# Requires a domain verified in Resend.
# CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
